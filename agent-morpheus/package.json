{
  "name": "morpheus",
  "version": "1.0.0",
  "description": "Autonomous Risk Management & Trailing Stop-Loss Guard Agent for Solana (Agent 3 of Multi-Agent Protocol)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:unit": "mocha -r ts-node/register \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.js",
    "cli": "ts-node cli/src/index.ts",
    "agent": "ts-node agent/src/index.ts",
    "preflight": "ts-node scripts/preflight-mainnet.ts",
    "verify-mainnet": "python3 scripts/verify_mainnet.py",
    "new-keypair": "node scripts/new-program-keypair.js",
    "freeze-program": "node scripts/freeze-program.js",
    "verify:build": "bash scripts/verify-build.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "bs58": "^6.0.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
