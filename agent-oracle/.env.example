# Agent / CLI environment (copy to .env and edit)
# NEVER commit .env or key files.

# localnet | devnet | mainnet-beta
CLUSTER=localnet
# Optional explicit RPC (recommended for production agents)
# RPC_URL=https://your-helius-or-quicknode-rpc

# Agent identity: EITHER a keypair file OR a base58 secret key.
# The identity only pays fees; it cannot move user funds.
AGENT_KEYPAIR_PATH=./id.json
# AGENT_SECRET_KEY_B58=

POLL_INTERVAL_SECS=30
PRIORITY_FEE_MICRO_LAMPORTS=100000
CRANK_TRADE_CU=400000
CRANK_STAKE_CU=150000

# Optional HTTP healthcheck/metrics port for container orchestrators & OWASP ZAP scanning
# AGENT_HEALTH_PORT=8080

# ---------------------------------------------------------------------------
# Pyth oracle supply (trading cranks) — SINGLE FEED: SOL/USD
#
# The program accepts ONLY receiver `PriceUpdateV2` accounts owned by the
# config-pinned Pyth receiver program (rec5EKMG…LtFJ) and enforces the
# discriminator, feed id, staleness and confidence on-chain. The classic
# push-oracle accounts are decommissioned on mainnet and NOT supported.
#
# Mode 1 — pin an account you keep fresh with Pyth's official tooling
#          (Hermes + the receiver program's post_updates_atomic):
# PYTH_SOL_USD_PRICE_ACCOUNT=<PriceUpdateV2 account you maintain>
#
# Mode 2 (mainnet default) — auto-discovery: the agent scans the Pyth
# receiver program for the FRESHEST account carrying the SOL/USD feed
# id and caches the result. Needs a production RPC (the free public
# endpoint may throttle getProgramAccounts).
# PYTH_SOL_USD_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
PYTH_MAX_STALENESS_SECS=30
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Jupiter route building (trading cranks)
#
# Mainnet (CLUSTER=mainnet-beta) uses the live Jupiter Swap API by default.
# Set JUP_API_BASE=off ONLY on localnet/devnet to force the mock builder.
# JUP_API_BASE=https://lite-api.jup.ag/swap/v1
JUP_SLIPPAGE_BPS=50
# ---------------------------------------------------------------------------
